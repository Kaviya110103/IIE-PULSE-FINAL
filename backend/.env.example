# Backend environment variables
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret
DJANGO_DEBUG=False
DEPLOYMENT_DOMAIN=iiepulse.indrainstitute.com
DEPLOYMENT_SCHEME=https
DJANGO_ALLOWED_HOSTS=iiepulse.indrainstitute.com,www.iiepulse.indrainstitute.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://iiepulse.indrainstitute.com,https://www.iiepulse.indrainstitute.com
CORS_ALLOWED_ORIGINS=https://iiepulse.indrainstitute.com,https://www.iiepulse.indrainstitute.com
APP_PORTAL_URL=https://iiepulse.indrainstitute.com

# Use either DATABASE_URL or the DB_* values below.
DATABASE_URL=
DB_NAME=iiepulse
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSL=False
DB_CONN_MAX_AGE=600

DJANGO_MEDIA_ROOT=

BREVO_API_KEY=replace-with-brevo-api-key
DEFAULT_FROM_EMAIL=your-email@example.com
DEFAULT_FROM_NAME=IIE Pulse
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

MSG91_WIDGET_ID=replace-with-msg91-widget-id
MSG91_AUTH_TOKEN=replace-with-msg91-auth-token

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
